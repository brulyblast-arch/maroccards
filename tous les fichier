.mc{color:var(--gold)}.dot{color:var(--gold2);font-size:.55em;vertical-align:super}
.nav-links{display:flex;gap:28px;font-size:.88rem;color:var(--muted)}
.nav-links a:hover{color:var(--gold);transition:color .2s}
.nav-actions{display:flex;gap:10px;align-items:center}
.btn{display:inline-flex;align-items:center;gap:6px;padding:9px 20px;border-radius:8px;font-size:.87rem;font-weight:600;cursor:pointer;transition:all .25s;border:none}
.btn-ghost{background:transparent;border:1px solid rgba(255,255,255,.15);color:var(--text)}
.btn-ghost:hover{border-color:var(--gold);color:var(--gold)}
.btn-primary{background:linear-gradient(135deg,var(--gold),var(--gold2));color:var(--dark)}
.btn-primary:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(201,168,76,.4)}
.lang-switch{display:flex;gap:5px}
.lang-btn{padding:4px 9px;border-radius:6px;font-size:.76rem;font-weight:600;cursor:pointer;border:1px solid rgba(255,255,255,.15);color:var(--muted);background:transparent;transition:all .2s}
.lang-btn.active,.lang-btn:hover{background:var(--gold);color:var(--dark);border-color:var(--gold)}

/* HERO */
.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:120px 20px 80px;position:relative;overflow:hidden}
.hero-bg{position:absolute;inset:0;background-image:url('data:image/jpeg;base64,');background-size:cover;background-position:center;filter:brightness(.3);z-index:0}
.hero-overlay{position:absolute;inset:0;z-index:1;background:radial-gradient(ellipse at 50% 40%,rgba(79,142,247,.12) 0%,transparent 70%),linear-gradient(to bottom,transparent 60%,var(--dark) 100%)}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(201,168,76,.12);border:1px solid rgba(201,168,76,.35);color:var(--gold);border-radius:50px;padding:6px 16px;font-size:.81rem;font-weight:600;margin-bottom:28px;position:relative;z-index:2}
.pulse{display:inline-block;width:6px;height:6px;background:var(--gold);border-radius:50%;animation:pulse 1.5s infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.5)}}
.hero h1{font-size:clamp(2rem,5vw,3.8rem);font-weight:900;line-height:1.1;position:relative;z-index:2;margin-bottom:18px;letter-spacing:-1px}
.highlight{background:linear-gradient(135deg,var(--gold),var(--gold2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero p{font-size:1.05rem;color:var(--muted);max-width:540px;position:relative;z-index:2;margin-bottom:36px}
.hero-cta{display:flex;gap:12px;justify-content:center;position:relative;z-index:2;flex-wrap:wrap}
.btn-lg{padding:14px 30px;font-size:.98rem;border-radius:10px}
.btn-outline{background:transparent;border:1.5px solid rgba(255,255,255,.25);color:var(--text);padding:13px 28px;border-radius:10px;font-size:.98rem;font-weight:600;cursor:pointer;transition:all .25s}
.btn-outline:hover{border-color:var(--gold);color:var(--gold)}
.hero-stats{display:flex;gap:48px;justify-content:center;margin-top:56px;position:relative;z-index:2;flex-wrap:wrap}
.stat{text-align:center}
.stat-num{font-size:2rem;font-weight:900;color:var(--gold)}
.stat-label{font-size:.8rem;color:var(--muted);margin-top:2px}

/* SEARCH */
.search-section{padding:0 20px 60px;display:flex;justify-content:center;position:relative;z-index:2;margin-top:-28px}
.search-box{background:rgba(21,29,53,.97);border:1px solid rgba(201,168,76,.2);border-radius:16px;padding:24px 26px;width:100%;max-width:820px;box-shadow:0 20px 60px rgba(0,0,0,.5);backdrop-filter:blur(20px)}
.search-tabs{display:flex;gap:7px;margin-bottom:14px;flex-wrap:wrap}
.stab{padding:6px 14px;border-radius:8px;font-size:.8rem;font-weight:600;cursor:pointer;border:1px solid rgba(255,255,255,.1);color:var(--muted);background:transparent;transition:all .2s}
.stab.active,.stab:hover{background:var(--gold);color:var(--dark);border-color:var(--gold)}
.search-row{display:flex;gap:10px}
.search-input{flex:1;padding:12px 16px;border-radius:10px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:var(--text);font-size:.93rem;outline:none;transition:border-color .2s}
.search-input::placeholder{color:var(--muted)}
.search-input:focus{border-color:var(--gold)}
.search-btn{padding:12px 22px;border-radius:10px;background:linear-gradient(135deg,var(--gold),var(--gold2));color:var(--dark);font-weight:700;border:none;cursor:pointer;font-size:.93rem;white-space:nowrap;transition:all .2s}
.search-btn:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(201,168,76,.4)}

/* SECTIONS */
section{padding:80px 20px}
.section-header{text-align:center;margin-bottom:48px}
.section-tag{display:inline-block;background:rgba(201,168,76,.12);border:1px solid rgba(201,168,76,.3);color:var(--gold);padding:4px 14px;border-radius:50px;font-size:.76rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:12px}
.section-header h2{font-size:clamp(1.6rem,3vw,2.4rem);font-weight:800;margin-bottom:10px}
.section-header p{color:var(--muted);font-size:.97rem;max-width:480px;margin:0 auto}

/* GAMES */
.games-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;max-width:1100px;margin:0 auto}
.game-card{background:var(--cardbg);border:1px solid rgba(255,255,255,.07);border-radius:var(--radius);overflow:hidden;cursor:pointer;transition:all .3s;position:relative}
.game-card:hover{transform:translateY(-6px);border-color:var(--gold);box-shadow:0 20px 50px rgba(0,0,0,.5)}
.game-card-img{height:150px;width:100%;object-fit:cover;transition:transform .4s}
.game-card:hover .game-card-img{transform:scale(1.06)}
.game-emoji-img{height:150px;width:100%;display:flex;align-items:center;justify-content:center;font-size:3.5rem}
.game-card-body{padding:14px}
.game-card-title{font-weight:700;font-size:.93rem;margin-bottom:3px}
.game-card-count{font-size:.78rem;color:var(--muted)}
.game-badge{position:absolute;top:10px;right:10px;background:rgba(10,14,26,.85);border:1px solid rgba(201,168,76,.4);color:var(--gold);font-size:.7rem;font-weight:700;padding:3px 8px;border-radius:50px;backdrop-filter:blur(8px)}

/* LISTINGS */
.featured-bg{background:var(--dark2)}
.cards-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(195px,1fr));gap:18px;max-width:1100px;margin:0 auto}
.listing-card{background:var(--cardbg);border:1px solid rgba(255,255,255,.07);border-radius:var(--radius);overflow:hidden;cursor:pointer;transition:all .3s}
.listing-card:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-color:rgba(201,168,76,.3)}
.listing-img{height:175px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
.listing-img img{width:100%;height:100%;object-fit:cover}
.listing-condition{position:absolute;top:8px;left:8px;font-size:.68rem;font-weight:700;padding:3px 7px;border-radius:5px;background:rgba(34,197,94,.9);color:white}
.listing-verified{position:absolute;top:8px;right:8px;font-size:.68rem;padding:3px 7px;border-radius:5px;background:rgba(79,142,247,.9);color:white;font-weight:700}
.listing-body{padding:13px}
.listing-game{font-size:.7rem;color:var(--gold);font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px}
.listing-name{font-weight:700;font-size:.9rem;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.listing-set{font-size:.76rem;color:var(--muted);margin-bottom:9px}
.listing-footer{display:flex;align-items:center;justify-content:space-between}
.listing-price{font-size:1.05rem;font-weight:800;color:var(--gold)}
.listing-right{display:flex;align-items:center;gap:5px}
.listing-seller{font-size:.72rem;color:var(--muted)}
.seller-stars{color:#F59E0B;font-size:.68rem}
.add-cart{width:30px;height:30px;border-radius:7px;background:rgba(201,168,76,.15);border:1px solid rgba(201,168,76,.3);color:var(--gold);cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;font-size:.95rem;font-weight:700}
.add-cart:hover{background:var(--gold);color:var(--dark)}

/* STEPS */
.steps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:24px;max-width:1000px;margin:0 auto}
.step-card{text-align:center;padding:32px 22px;background:var(--cardbg);border:1px solid rgba(255,255,255,.07);border-radius:var(--radius);transition:all .3s}
.step-card:hover{border-color:rgba(201,168,76,.3);transform:translateY(-4px)}
.step-icon{width:60px;height:60px;border-radius:15px;margin:0 auto 18px;display:flex;align-items:center;justify-content:center;font-size:1.7rem;background:linear-gradient(135deg,rgba(201,168,76,.15),rgba(201,168,76,.05));border:1px solid rgba(201,168,76,.2)}
