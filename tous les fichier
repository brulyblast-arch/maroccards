                  ...(profile?.is_admin ? [{ href: "/admin", icon: <Shield size={16} />, label: "🛡️ Tableau de bord Admin", color: "#EF4444" }] : []),
                ].map(action => (
                  <Link key={action.href} href={action.href}>
