              </div>

              <div style={{ display: "flex", gap: 10, marginTop: 4 }}>
                <button type="button" onClick={() => setStep(1)} style={{
                  flex: 1, padding: "12px", borderRadius: 10, fontWeight: 600, fontSize: "0.9rem",
