/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:1000;display:flex;align-items:center;justify-content:space-between;padding:0 40px;height:70px;background:rgba(10,14,26,.88);backdrop-filter:blur(16px);border-bottom:1px solid rgba(201,168,76,.15)}
