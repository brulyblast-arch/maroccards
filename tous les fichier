.step-card h3{font-size:1rem;font-weight:700;margin-bottom:7px}
.step-card p{font-size:.83rem;color:var(--muted);line-height:1.65}

/* FEATURES */
.trust-bg{background:var(--dark2)}
.features-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:22px;max-width:1100px;margin:0 auto}
.feature-card{display:flex;gap:16px;padding:26px;background:var(--cardbg);border:1px solid rgba(255,255,255,.07);border-radius:var(--radius);transition:all .3s}
.feature-card:hover{border-color:rgba(201,168,76,.25);transform:translateY(-3px)}
.feature-icon{width:48px;height:48px;min-width:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.3rem}
.fi-gold{background:rgba(201,168,76,.12);border:1px solid rgba(201,168,76,.2)}
.fi-blue{background:rgba(79,142,247,.12);border:1px solid rgba(79,142,247,.2)}
.fi-green{background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.2)}
.fi-red{background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.2)}
.feature-card h3{font-size:.95rem;font-weight:700;margin-bottom:5px}
.feature-card p{font-size:.81rem;color:var(--muted);line-height:1.65}

/* SELLERS */
.sellers-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:26px;max-width:900px;margin:0 auto}
.seller-type{padding:34px 28px;border-radius:18px;border:1px solid rgba(255,255,255,.08);position:relative;overflow:hidden;transition:all .3s}
