    }}>
      <div style={{
        position: "absolute", top: "15%", right: "15%", width: 350, height: 350,
        background: "radial-gradient(circle, rgba(201,168,76,0.06), transparent 70%)",
        pointerEvents: "none",
      }} />

      <div style={{
        width: "100%", maxWidth: 500,
        background: "rgba(15,21,37,0.95)",
