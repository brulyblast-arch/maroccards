.seller-type-icon{font-size:2.4rem;margin-bottom:14px}
.seller-type h3{font-size:1.15rem;font-weight:800;margin-bottom:8px}
.seller-type p{font-size:.85rem;color:var(--muted);line-height:1.7;margin-bottom:18px}
.seller-type ul{list-style:none;display:flex;flex-direction:column;gap:7px}
.seller-type ul li{font-size:.83rem;display:flex;align-items:flex-start;gap:7px;color:var(--muted)}
.seller-type ul li::before{content:"✓";color:var(--green);font-weight:700;margin-top:1px}
.glow-abs{position:absolute;top:-40px;right:-40px;width:140px;height:140px;pointer-events:none;border-radius:50%}

/* TESTIMONIALS */
.testi-bg{background:var(--dark2)}
.testi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:20px;max-width:1000px;margin:0 auto}
